# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# JWT
SECRET_KEY=your-secret-key-at-least-32-characters

# Database
# Local SQLite (development):
# DATABASE_URL=sqlite:///./qurator.db

# Local MySQL (via Cloud SQL Proxy):
# DATABASE_URL=mysql+pymysql://root:PASSWORD@127.0.0.1:3306/zubu9dan

# Google Cloud SQL (MySQL) - via Unix socket (Cloud Run):
# DATABASE_URL=mysql+pymysql://root:PASSWORD@/zubu9dan?unix_socket=/cloudsql/zubu9dan-1baf2:asia-northeast3:zubu9dan-mysql

DATABASE_URL=mysql+pymysql://root:PASSWORD@127.0.0.1:3306/zubu9dan

# Frontend URL (for OAuth callback redirect and CORS)
FRONTEND_URL=http://localhost:3000

# Port (Cloud Run sets this automatically)
PORT=8080
