{
  "hosting": {
    "public": ".next",
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://www.zubu9dan.com/:path*",
        "type": 301,
        "conditions": {
          "and": [
            { "host": ["zubu9dan.com"] }
          ]
        }
      }
    ]
  }
}
